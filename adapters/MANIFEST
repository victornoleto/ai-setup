link	../skills/impeccable-claude	.claude/skills/impeccable
link	../skills/impeccable	.agents/skills/impeccable
link	../skills/impeccable	.kiro/skills/impeccable
skill	../skills/entrega
skill	../skills/revisao
skill	../skills/handoff
skill	../skills/orq-setup
skill	../skills/writing-for-agents
skill	../skills/wizard
skill	../skills/retro
