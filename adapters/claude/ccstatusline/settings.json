{
  "version": 4,
  "lines": [
    [
      {
        "id": "cwd",
        "type": "current-working-dir",
        "metadata": {
          "abbreviateHome": "true"
        }
      },
      {
        "id": "s1",
        "type": "separator"
      },
      {
        "id": "branch",
        "type": "git-branch"
      }
    ],
    [
      {
        "id": "session-label",
        "type": "custom-text",
        "customText": "5h Usage: "
      },
      {
        "id": "session",
        "type": "session-usage",
        "rawValue": true,
        "numberFormat": {
          "style": "whole"
        }
      },
      {
        "id": "session-reset-gap",
        "type": "custom-text",
        "customText": " "
      },
      {
        "id": "session-reset",
        "type": "custom-command",
        "commandPath": "@HOME@/.config/ccstatusline/reset-left.sh five_hour"
      },
      {
        "id": "s2",
        "type": "separator",
        "character": " │ "
      },
      {
        "id": "weekly-label",
        "type": "custom-text",
        "customText": "7d Usage: "
      },
      {
        "id": "weekly",
        "type": "weekly-usage",
        "rawValue": true,
        "numberFormat": {
          "style": "whole"
        }
      },
      {
        "id": "weekly-reset-gap",
        "type": "custom-text",
        "customText": " "
      },
      {
        "id": "weekly-reset",
        "type": "custom-command",
        "commandPath": "@HOME@/.config/ccstatusline/reset-left.sh seven_day"
      },
      {
        "id": "s3",
        "type": "separator",
        "character": " │ "
      },
      {
        "id": "ctx-label",
        "type": "custom-text",
        "customText": "Context: "
      },
      {
        "id": "ctx",
        "type": "context-percentage",
        "rawValue": true,
        "numberFormat": {
          "style": "whole"
        }
      },
      {
        "id": "ctx-suffix",
        "type": "custom-text",
        "customText": " Used"
      },
      {
        "id": "s4",
        "type": "separator",
        "character": " │ "
      },
      {
        "id": "model",
        "type": "model"
      },
      {
        "id": "effort-sep",
        "type": "custom-text",
        "customText": " · "
      },
      {
        "id": "effort",
        "type": "thinking-effort",
        "rawValue": true
      }
    ],
    []
  ],
  "flexMode": "full"
}
