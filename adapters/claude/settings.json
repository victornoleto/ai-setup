{
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet"
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "allow": [
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr checks *)",
      "Bash(gh issue view *)",
      "Bash(gh issue list *)",
      "Bash(gh run view *)",
      "Bash(gh run list *)",
      "Bash(gh auth status)"
    ],
    "deny": [
      "Read(~/.claude/.credentials.json)",
      "Read(~/.codex/auth.json)",
      "Read(~/.gemini/oauth_creds.json)",
      "Read(~/.config/ai-memory/server.env)",
      "Edit(~/.config/ai-memory/server.env)"
    ],
    "ask": [
      "Bash(gh pr merge *)",
      "Bash(gh repo delete *)",
      "Bash(gh api * -X *)",
      "Bash(gh api * --method *)",
      "Bash(gh api -X *)",
      "Bash(gh api --method *)",
      "Bash(gh api * -f *)",
      "Bash(gh api * -F *)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "@HOME@/.local/share/ai-memory/native-runner/ai-memory --data-dir @HOME@/.local/share/ai-memory hook --event session-start --agent claude-code --server-url http://127.0.0.1:49374 --project-strategy repo-root"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "@HOME@/.local/share/ai-memory/native-runner/ai-memory --data-dir @HOME@/.local/share/ai-memory hook --event user-prompt-submit --agent claude-code --server-url http://127.0.0.1:49374 --project-strategy repo-root"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "@HOME@/.local/share/ai-memory/native-runner/ai-memory --data-dir @HOME@/.local/share/ai-memory hook --event stop --agent claude-code --server-url http://127.0.0.1:49374 --project-strategy repo-root"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "@HOME@/.local/share/ai-memory/native-runner/ai-memory --data-dir @HOME@/.local/share/ai-memory hook --event subagent-start --agent claude-code --server-url http://127.0.0.1:49374 --project-strategy repo-root"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "@HOME@/.local/share/ai-memory/native-runner/ai-memory --data-dir @HOME@/.local/share/ai-memory hook --event subagent-stop --agent claude-code --server-url http://127.0.0.1:49374 --project-strategy repo-root"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "@HOME@/.local/share/ai-memory/native-runner/ai-memory --data-dir @HOME@/.local/share/ai-memory hook --event pre-tool-use --agent claude-code --server-url http://127.0.0.1:49374 --project-strategy repo-root"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "@HOME@/.local/share/ai-memory/native-runner/ai-memory --data-dir @HOME@/.local/share/ai-memory hook --event post-tool-use --agent claude-code --server-url http://127.0.0.1:49374 --project-strategy repo-root"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "@HOME@/.local/share/ai-memory/native-runner/ai-memory --data-dir @HOME@/.local/share/ai-memory hook --event pre-compact --agent claude-code --server-url http://127.0.0.1:49374 --project-strategy repo-root"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "@HOME@/.local/share/ai-memory/native-runner/ai-memory --data-dir @HOME@/.local/share/ai-memory hook --event session-end --agent claude-code --server-url http://127.0.0.1:49374 --project-strategy repo-root",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "@HOME@/.local/share/ai-memory/native-runner/ai-memory --data-dir @HOME@/.local/share/ai-memory hook --event post-tool-use --agent claude-code --server-url http://127.0.0.1:49374 --project-strategy repo-root"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "ccstatusline",
    "padding": 0
  },
  "enabledPlugins": {
    "commit-commands@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {},
  "outputStyle": "Concise",
  "language": "Brazilian Portuguese (pt-BR)",
  "effortLevel": "medium",
  "modelSettings": {
    "claude-sonnet-5": {
      "effortLevel": "high"
    },
    "claude-opus-5": {
      "effortLevel": "high"
    },
    "claude-fable-5": {
      "effortLevel": "medium"
    },
    "claude-fable-5-1": {
      "effortLevel": "high"
    },
    "claude-opus-5-5": {
      "effortLevel": "medium",
      "autoCompactWindow": 400000
    },
    "claude-sonnet-5-5": {
      "effortLevel": "medium"
    }
  },
  "pluginConfigs": {
    "cc-plugin-agents-md@builtin": {
      "options": {
        "instructionFiles": "claude-md-and-agents-md"
      }
    }
  },
  "tui": "fullscreen",
  "autoMemoryEnabled": false,
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark-ansi"
}
