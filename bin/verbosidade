#!/usr/bin/env python3
"""Mede o tamanho das respostas finais do Claude Code (última mensagem de texto de cada turno).

Uso: verbosidade [dias]   (padrão 14). Lê ~/.claude/projects/*/*.jsonl; só leitura.
Meta: mediana <= 80 palavras, menos de 5% acima de 300.
"""
import glob, json, os, statistics, sys, time

dias = int(sys.argv[1]) if len(sys.argv) > 1 else 14
corte = time.time() - dias * 86400
finais = []
for f in glob.glob(os.path.expanduser("~/.claude/projects/*/*.jsonl")):
    if os.path.getmtime(f) < corte:
        continue
    ultima = None
    with open(f, errors="ignore") as fh:
        for linha in fh:
            try:
                o = json.loads(linha)
            except ValueError:
                continue
            if o.get("isSidechain"):
                continue
            c = (o.get("message") or {}).get("content")
            if o.get("type") == "user":
                ferramenta = isinstance(c, list) and any(isinstance(x, dict) and x.get("type") == "tool_result" for x in c)
                if not ferramenta and ultima is not None:
                    finais.append(ultima)
                    ultima = None
            elif o.get("type") == "assistant" and isinstance(c, list):
                txt = "".join(x.get("text", "") for x in c if isinstance(x, dict) and x.get("type") == "text")
                if txt.strip():
                    ultima = txt
    if ultima:
        finais.append(ultima)

w = sorted(len(x.split()) for x in finais)
if len(w) < 10:
    sys.exit(f"só {len(w)} respostas em {dias} dias: amostra pequena demais")
p90 = w[int(len(w) * 0.9)]
acima = 100 * sum(x > 300 for x in w) / len(w)
print(f"{len(w)} respostas em {dias} dias: mediana {statistics.median(w):.0f} palavras, p90 {p90}, {acima:.0f}% acima de 300")
