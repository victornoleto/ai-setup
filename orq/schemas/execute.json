{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "summary",
    "commits",
    "checks",
    "pending",
    "questions"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "done",
        "needs_decision",
        "blocked"
      ]
    },
    "summary": {
      "type": "string"
    },
    "commits": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "hash",
          "message"
        ],
        "properties": {
          "hash": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "command",
          "result"
        ],
        "properties": {
          "command": {
            "type": "string"
          },
          "result": {
            "type": "string"
          }
        }
      }
    },
    "pending": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "question",
          "context",
          "options"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "id curto, kebab-case"
          },
          "question": {
            "type": "string"
          },
          "context": {
            "type": "string",
            "description": "por que a dúvida existe e o que já foi conferido"
          },
          "options": {
            "type": "array",
            "minItems": 2,
            "maxItems": 4,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "label",
                "detail"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "label": {
                  "type": "string"
                },
                "detail": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}
