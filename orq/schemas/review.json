{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "verdict",
    "summary",
    "highlights",
    "issues",
    "questions"
  ],
  "properties": {
    "verdict": {
      "type": "string",
      "enum": [
        "approved",
        "changes"
      ]
    },
    "summary": {
      "type": "string"
    },
    "highlights": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "string"
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "severity",
          "where",
          "what",
          "fix"
        ],
        "properties": {
          "severity": {
            "type": "string",
            "enum": [
              "alta",
              "media",
              "baixa"
            ]
          },
          "where": {
            "type": "string"
          },
          "what": {
            "type": "string"
          },
          "fix": {
            "type": "string"
          }
        }
      }
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "question",
          "context",
          "options"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "id curto, kebab-case"
          },
          "question": {
            "type": "string"
          },
          "context": {
            "type": "string",
            "description": "por que a dúvida existe e o que já foi conferido"
          },
          "options": {
            "type": "array",
            "minItems": 2,
            "maxItems": 4,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "label",
                "detail"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "label": {
                  "type": "string"
                },
                "detail": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}
