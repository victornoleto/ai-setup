# Modelo: o `ai-usage-monitor install` grava em ~/.config/systemd/user/ trocando @CONFIG@.
[Unit]
Description=ai-usage-monitor: histórico de uso dos harness de IA
After=network-online.target

[Service]
ExecStart=%h/.ai-setup/bin/ai-usage-monitor --config @CONFIG@ run
Restart=on-failure
RestartSec=30

[Install]
WantedBy=default.target
